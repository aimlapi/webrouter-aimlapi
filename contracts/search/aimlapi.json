{
  "provider": "aimlapi",
  "method": "search",
  "class": "web_router.providers.aimlapi.AimlapiProvider",
  "transport": {
    "kind": "http",
    "base_url": "https://tools.aimlapi.com",
    "paths": {
      "search_path": "/v1/tools/run"
    },
    "method": "POST",
    "auth_header": "Authorization"
  },
  "credentials": [
    "AIMLAPI_API_KEY"
  ],
  "keyless": null,
  "always_sent": {
    "body.input.query": "probe query",
    "body.tool": "web/search",
    "body.wait_ms": 55000
  },
  "options": {
    "max_results": {
      "sample": {
        "body.input.max_results": 3
      }
    },
    "include_domains": {
      "sample": {
        "body.input.include_domains": [
          "example.com"
        ]
      }
    }
  },
  "not_mapped": [
    "country",
    "effort",
    "exclude_domains",
    "locale",
    "recency",
    "search_depth"
  ],
  "source": [
    "https://docs.aimlapi.com/quickstart/toolbox"
  ],
  "verified": {
    "max_results": "live: tests/providers/test_aimlapi.py::test_live_search_returns_web_results",
    "include_domains": "live: web/search input schema from POST /v1/tools/inspect, 2026-11-24"
  },
  "vendor_options": {
    "max_cost_usd": {
      "status": "passthrough",
      "note": "a cap on the price of the run in USD; a run quoted above it is refused before it starts."
    }
  }
}
